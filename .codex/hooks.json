{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$(git rev-parse --show-toplevel)\" && export CLAUDE_PROJECT_DIR && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/web-visual/design-gate.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/lint-patch.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-tracking-sync.js\" --hook --codex",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$(git rev-parse --show-toplevel)\" && export CLAUDE_PROJECT_DIR && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/web-visual/audit-reminder.sh\""
          }
        ]
      }
    ]
  }
}
