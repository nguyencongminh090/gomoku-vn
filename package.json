{
  "name": "gomoku-vn",
  "version": "1.0.0",
  "description": "Play3CR — Real-time multiplayer Gomoku platform with WALL & PORTAL mechanics",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:stable": "node server/index.js",
    "build": "vite build",
    "client:dev": "vite",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "capacity-test": "node scripts/capacity-test/orchestrator.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.1",
    "enquirer": "^2.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.4",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "socket.io-client": "^4.8.3",
    "vite": "^8.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/server/tests/__mocks__/uuid.js"
    }
  }
}
